#
# Generic drivers/frameworks
#
CONFIG_COMMON_CLK_PWM=m
CONFIG_CPUFREQ_DT=m
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_DMABUF_HEAPS_CMA=m
CONFIG_DMABUF_HEAPS_SYSTEM=m
CONFIG_LEDS_GPIO=m
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_PWRSEQ_EMMC=m
CONFIG_PWRSEQ_SIMPLE=m
CONFIG_REGULATOR_PWM=m
CONFIG_USB_DWC2=m

#
# Networking
#
# CONFIG_DWMAC_IPQ806X is not set
# CONFIG_DWMAC_QCOM_ETHQOS is not set
# CONFIG_DWMAC_SUN55I is not set
# CONFIG_DWMAC_SUN8I is not set
# CONFIG_DWMAC_SUNXI is not set
CONFIG_REALTEK_PHY=m
CONFIG_STMMAC_ETH=m
CONFIG_STMMAC_PLATFORM=m

#
# WLAN
#
CONFIG_B43=m
CONFIG_B43_BCMA=y
CONFIG_B43_BCMA_PIO=y
# CONFIG_B43_BUSES_BCMA is not set
CONFIG_B43_BUSES_BCMA_AND_SSB=y
# CONFIG_B43_BUSES_SSB is not set
CONFIG_B43_HWRNG=y
CONFIG_B43_PCICORE_AUTOSELECT=y
CONFIG_B43_PCI_AUTOSELECT=y
CONFIG_B43_PHY_G=y
CONFIG_B43_PHY_HT=y
CONFIG_B43_PHY_LP=y
CONFIG_B43_PHY_N=y
CONFIG_B43_PIO=y
CONFIG_B43_SDIO=y
CONFIG_B43_SSB=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BRCMFMAC_PROTO_MSGBUF=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMUTIL=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_CFG80211=m
# CONFIG_CFG80211_CRDA_SUPPORT is not set
# CONFIG_CFG80211_DEFAULT_PS is not set
CONFIG_MAC80211=m
CONFIG_NL80211_TESTMODE=y
CONFIG_WLAN_VENDOR_BROADCOM=y

#
# Amlogic
#
CONFIG_SERIAL_MESON=m
CONFIG_SERIAL_MESON_CONSOLE=y
#
# Amlogic drivers as modules
#

# core
CONFIG_MESON_IRQ_GPIO=m
CONFIG_MESON_SM=m
CONFIG_RESET_MESON=m
CONFIG_RESET_MESON_AUDIO_ARB=m
CONFIG_RTC_DRV_MESON_VRTC=m

# clocks
CONFIG_COMMON_CLK_AXG=m
CONFIG_COMMON_CLK_AXG_AUDIO=m
CONFIG_COMMON_CLK_C3_PERIPHERALS=n
CONFIG_COMMON_CLK_C3_PLL=n
CONFIG_COMMON_CLK_G12A=m
CONFIG_COMMON_CLK_GXBB=m
CONFIG_COMMON_CLK_MESON_AO_CLKC=m
CONFIG_COMMON_CLK_MESON_CLKC_UTILS=m
CONFIG_COMMON_CLK_MESON_CPU_DYNDIV=m
CONFIG_COMMON_CLK_MESON_DUALDIV=m
CONFIG_COMMON_CLK_MESON_EE_CLKC=m
CONFIG_COMMON_CLK_MESON_MPLL=m
CONFIG_COMMON_CLK_MESON_PHASE=m
CONFIG_COMMON_CLK_MESON_PLL=m
CONFIG_COMMON_CLK_MESON_REGMAP=m
CONFIG_COMMON_CLK_MESON_SCLK_DIV=m
CONFIG_COMMON_CLK_MESON_VCLK=m
CONFIG_COMMON_CLK_MESON_VID_PLL_DIV=m
CONFIG_COMMON_CLK_S4_PERIPHERALS=n
CONFIG_COMMON_CLK_S4_PLL=n

# PHY
CONFIG_PHY_MESON8B_USB2=m
CONFIG_PHY_MESON_AXG_MIPI_DPHY=m
CONFIG_PHY_MESON_AXG_MIPI_PCIE_ANALOG=m
CONFIG_PHY_MESON_AXG_PCIE=m
CONFIG_PHY_MESON_G12A_MIPI_DPHY_ANALOG=m
CONFIG_PHY_MESON_G12A_USB2=m
CONFIG_PHY_MESON_G12A_USB3_PCIE=m
CONFIG_PHY_MESON_GXL_USB2=m

# peripherals
CONFIG_AMLOGIC_THERMAL=m
CONFIG_CRYPTO_DEV_AMLOGIC_GXL=m
CONFIG_DWMAC_MESON=m
CONFIG_HW_RANDOM_MESON=m
CONFIG_I2C_MESON=m
CONFIG_IR_MESON=m
CONFIG_KHADAS_MCU_FAN_THERMAL=m
CONFIG_MDIO_BUS_MUX_MESON_G12A=m
CONFIG_MESON_GXBB_WATCHDOG=m
CONFIG_MESON_GXL_PHY=m
CONFIG_MESON_SARADC=m
CONFIG_MESON_WATCHDOG=m
CONFIG_MFD_KHADAS_MCU=m
CONFIG_MMC_MESON_GX=m
CONFIG_PCI_MESON=m
CONFIG_PINCTRL_AMLOGIC_C3=n
CONFIG_PINCTRL_AMLOGIC_T7=n
CONFIG_PINCTRL_MESON=m
CONFIG_PINCTRL_MESON_A1=n
CONFIG_PINCTRL_MESON_AXG=m
CONFIG_PINCTRL_MESON_AXG_PMX=m
CONFIG_PINCTRL_MESON_G12A=m
CONFIG_PINCTRL_MESON_GXBB=m
CONFIG_PINCTRL_MESON_GXL=m
CONFIG_PINCTRL_MESON_S4=n
CONFIG_PWM_MESON=m
CONFIG_SPI_MESON_SPICC=m
CONFIG_SPI_MESON_SPIFC=m
CONFIG_USB_DWC3_MESON_G12A=m

# sound
CONFIG_SND_MESON_AXG_SOUND_CARD=m
CONFIG_SND_MESON_G12A_TOHDMITX=m
CONFIG_SND_MESON_GX_SOUND_CARD=m

# display / video
CONFIG_BPF_LIRC_MODE2=y
CONFIG_CEC_CORE=y
CONFIG_CEC_MESON_AO=m
CONFIG_CEC_MESON_G12A_AO=m
CONFIG_DRM_DW_HDMI=m
CONFIG_DRM_DW_HDMI_AHB_AUDIO=m
CONFIG_DRM_DW_HDMI_CEC=m
CONFIG_DRM_DW_HDMI_I2S_AUDIO=m
CONFIG_DRM_MESON=m
CONFIG_DRM_MESON_DW_HDMI=m
CONFIG_DRM_PANFROST=m
CONFIG_LIRC=y
CONFIG_MEDIA_CEC_RC=y
CONFIG_RC_CORE=y
CONFIG_VIDEO_MESON_GE2D=m
CONFIG_DRM_GEM_SHMEM_HELPER=y

# SoC drivers
CONFIG_MESON_CANVAS=m
CONFIG_MESON_CLK_MEASURE=m
CONFIG_MESON_EE_PM_DOMAINS=m
CONFIG_MESON_SECURE_PM_DOMAINS=m

#
# Amlogic drivers disable
#

# 32-bit SoC drivers
CONFIG_MESON6_TIMER=n
CONFIG_MESON_MX_SOCINFO=n

# only needed by DRM on S805X
CONFIG_MESON_GX_SOCINFO=n

